# Copy to .env.local. .env.local is git-ignored.

# Base URL of MS.SS.Core, used by the /api/core rewrite in next.config.js (dev: dotnet run).
API_URL=http://localhost:5080

# Set to true only when a reverse proxy already routes /api/core to the backend.
API_PROXY_DISABLED=false

# Path the browser calls. Keep aligned with the rewrite source in next.config.js.
NEXT_PUBLIC_API_BASE_PATH=/api/core
