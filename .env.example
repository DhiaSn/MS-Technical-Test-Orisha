# Copy to .env only to override the defaults; .env is git-ignored.
POSTGRES_DB=reception
POSTGRES_USER=reception
POSTGRES_PASSWORD=reception_local_dev

# Host ports; change only if the default is already taken locally.
POSTGRES_PORT=5433
API_PORT=5080
WEB_PORT=3000

# JWT signing secret for the API container. Leave empty to use the throwaway compose default
# (compose treats an empty value as unset); the API refuses to start with a secret under 32 bytes.
JWT_SECRET=
