{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "scalar/v1",
      "applicationUrl": "http://localhost:5080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/scalar/v1",
      "environmentVariables": {
        "ASPNETCORE_URLS": "http://+:8080",
        "ConnectionStrings__DefaultConnection": "Host=host.docker.internal;Port=5433;Database=reception;Username=reception;Password=reception_local_dev"
      },
      "publishAllPorts": true,
      "dockerfileContext": "..",
      "dockerfileRunArguments": "--add-host=host.docker.internal:host-gateway"
    }
  }
}
