{
  "AllowedOrigins": [
    "http://localhost:3000"
  ],
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "DatabaseSettings": {
    "AutoMigrate": false
  },
  "Seeding": {
    "Enabled": false
  },
  "TokenOptions": {
    "Issuer": "ms.ss.core",
    "Audience": "ms.ca.clientapp",
    "Secret": "",
    "AccessTokenExpirationSeconds": 28800
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "BehindReverseProxy": true,
  "AllowedHosts": "*"
}
